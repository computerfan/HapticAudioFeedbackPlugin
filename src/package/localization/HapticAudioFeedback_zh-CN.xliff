  <file original="$HapticAudioFeedback___main" source-language="en-US" target-language="zh-CN" datatype="plaintext">
    <body>
      <group id="@commands">
        <trans-unit id="$HapticAudioFeedback___Loupedeck.HapticAudioFeedback.ConfigureAudioHaptics" translate="yes">
          <source>Open haptic settings</source>
          <target>打开触觉设置</target>
        </trans-unit>
        <trans-unit id="$HapticAudioFeedback___Loupedeck.HapticAudioFeedback.ConfigureAudioHaptics###description" translate="yes">
          <source>Open browser settings at the current local port. Settings also have a standalone launcher file.</source>
          <target>在当前本地端口打开浏览器设置，也可使用独立的设置启动文件。</target>
        </trans-unit>
        <trans-unit id="$HapticAudioFeedback___Loupedeck.HapticAudioFeedback.ToggleAudioHaptics" translate="yes">
          <source>Toggle haptics</source>
          <target>切换触觉反馈</target>
        </trans-unit>
        <trans-unit id="$HapticAudioFeedback___Loupedeck.HapticAudioFeedback.ToggleAudioHaptics###description" translate="yes">
          <source>Pause or resume system audio haptics.</source>
          <target>暂停或恢复系统音频触觉反馈。</target>
        </trans-unit>
        <trans-unit id="$HapticAudioFeedback___SelectAudioProfile" translate="yes">
          <source>Select haptic profile</source>
          <target>选择触觉配置</target>
        </trans-unit>
        <trans-unit id="$HapticAudioFeedback___SelectAudioProfile###description" translate="yes">
          <source>Apply a listening profile while preserving whether audio haptics are paused.</source>
          <target>应用聆听配置，同时保留触觉反馈的暂停状态。</target>
        </trans-unit>
        <trans-unit id="$HapticAudioFeedback___PreviewAudioHaptic" translate="yes">
          <source>Preview haptic texture</source>
          <target>测试触感</target>
        </trans-unit>
        <trans-unit id="$HapticAudioFeedback___PreviewAudioHaptic###description" translate="yes">
          <source>Send one preset, including while audio haptics are paused.</source>
          <target>触发一次预设触感，音频触觉反馈暂停时也可使用。</target>
        </trans-unit>
        <trans-unit id="$HapticAudioFeedback___#DynamicFolder" translate="yes">
          <source>Dynamic Folder</source>
          <target>动态文件夹</target>
        </trans-unit>
      </group>
      <group id="@adjustments" />
      <group id="@groups">
        <trans-unit id="$HapticAudioFeedback___GroupName___F94B4FE9A4788697000D" translate="yes">
          <source>Audio haptics</source>
          <target>音频触觉反馈</target>
        </trans-unit>
      </group>
    </body>
