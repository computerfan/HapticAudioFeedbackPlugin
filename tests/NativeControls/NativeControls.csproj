<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <PluginApiDir Condition="'$(PluginApiDir)' == ''">C:\Program Files\Logi\LogiPluginService\</PluginApiDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PluginApi"><HintPath>$(PluginApiDir)PluginApi.dll</HintPath></Reference>
    <Compile Include="../../src/Actions/AudioHapticActions.cs" Link="AudioHapticActions.cs" />
    <Compile Include="../../src/Audio/CustomProfileStore.cs" Link="CustomProfileStore.cs" />
    <Compile Include="../../src/Audio/AudioProfiles.cs" Link="AudioProfiles.cs" />
    <Compile Include="../../src/Audio/AudioSettings.cs" Link="AudioSettings.cs" />
    <Compile Include="../../src/Audio/HapticPatterns.cs" Link="HapticPatterns.cs" />
  </ItemGroup>
</Project>
